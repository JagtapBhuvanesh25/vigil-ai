# Vigil AI — Environment Variables Template
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to git — only .env.example is tracked.

# ─── Security (REQUIRED — must not remain as placeholder) ─────────────────────
# API key used by the dashboard to authenticate with the backend.
VIGIL_API_KEY=CHANGE_ME_VIGIL_API_KEY

# JWT signing secret. Must be a long random string.
VIGIL_JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default dev): leave empty or set to sqlite path.
# PostgreSQL (prod):    set to postgresql+asyncpg://user:pass@host/db
VIGIL_DB_URL=sqlite+aiosqlite:///./vigil.db

# ─── LLM / Ollama ─────────────────────────────────────────────────────────────
VIGIL_OLLAMA_URL=http://localhost:11434
VIGIL_OLLAMA_MODEL=qwen2.5:7b

# Set to "true" to use scripted mock responses instead of a real Ollama model.
# Required for cloud demo deployments where Ollama is not available.
VIGIL_MOCK_LLM=false

# ─── Inbox ────────────────────────────────────────────────────────────────────
# Directory watched for incoming .eml files (mock inbox mode).
VIGIL_MOCK_INBOX_PATH=./tests/fixtures/emails

# ─── Risk Scoring Defaults ────────────────────────────────────────────────────
# Weights for the three detector families (Algorithm 1).
# Override here to experiment without touching defaults.yaml.
# VIGIL_WEIGHT_ANOMALY=12.0
# VIGIL_WEIGHT_DECEPTION=80.0
# VIGIL_WEIGHT_HEURISTIC=20.0
# VIGIL_RISK_DECAY=0.98
